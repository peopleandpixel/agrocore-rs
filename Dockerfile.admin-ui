# Multi-stage Dockerfile for agrocore Admin UI (WASM)
# Build stage
FROM rust:1.98-bookworm AS builder

# Install system dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install wasm target and wasm-pack (pinned for reproducible builds)
RUN rustup target add wasm32-unknown-unknown
RUN cargo install wasm-pack --version 0.13.1

# Set working directory
WORKDIR /app

# Copy Cargo files first for better caching
COPY Cargo.toml Cargo.lock ./
COPY crates/shared/Cargo.toml crates/shared/
COPY crates/admin-ui/Cargo.toml crates/admin-ui/

# Create dummy source files to build dependencies
RUN mkdir -p crates/shared/src crates/admin-ui/src
RUN echo "// dummy" > crates/shared/src/lib.rs
RUN echo "// dummy" > crates/admin-ui/src/lib.rs

# Build dependencies (this layer will be cached)
RUN cd crates/admin-ui && cargo build --target wasm32-unknown-unknown --release

# Copy actual source code
COPY crates/shared/src crates/shared/src/
COPY crates/admin-ui/src crates/admin-ui/src/
COPY crates/admin-ui/locales crates/admin-ui/locales/

# Build the actual WASM
RUN cd crates/admin-ui && cargo build --target wasm32-unknown-unknown --release

# Runtime stage - Nginx to serve static files
FROM nginx:alpine AS runtime

# Copy nginx config
COPY crates/admin-ui/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built WASM and static assets
COPY --from=builder /app/crates/admin-ui/target/wasm32-unknown-unknown/release/admin-ui.wasm /usr/share/nginx/html/
COPY --from=builder /app/crates/admin-ui/index.html /usr/share/nginx/html/
COPY --from=builder /app/crates/admin-ui/public /usr/share/nginx/html/

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/ || exit 1

# Run nginx
CMD ["nginx", "-g", "daemon off;"]
# Multi-stage Dockerfile for agrocore Admin UI (WASM)
# Build stage - builds WASM if artifacts not provided
FROM rust:1.97-bookworm AS builder

# Install system dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install wasm target and wasm-pack (pinned for reproducible builds)
RUN rustup target add wasm32-unknown-unknown
RUN cargo install wasm-pack --version 0.13.1

# Set working directory
WORKDIR /app

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY crates/ ./crates/

# Copy REAL logging crate (needed for macro exports in dependent crates)
RUN rm -rf crates/logging
COPY crates/logging ./crates/logging

# Copy SQLx query cache (needed for offline builds)
COPY .sqlx ./.sqlx

# Build dependencies (this layer will be cached) - only build admin-ui deps
RUN cargo build --target wasm32-unknown-unknown --release -p agrocore-shared -p agrocore-logging -p admin-ui --lib 2>/dev/null || true

# Build the actual WASM (or use prebuilt if available via ARG)
ARG PREBUILT_WASM_PATH=""
RUN if [ -n "$PREBUILT_WASM_PATH" ] && [ -f "$PREBUILT_WASM_PATH" ]; then \
      echo "Using prebuilt WASM from $PREBUILT_WASM_PATH"; \
      mkdir -p /app/crates/admin-ui/target/wasm32-unknown-unknown/release/; \
      cp "$PREBUILT_WASM_PATH" /app/crates/admin-ui/target/wasm32-unknown-unknown/release/admin-ui.wasm; \
    else \
      echo "Building WASM from source..."; \
      cd /app/crates/admin-ui && \
      cargo build --target wasm32-unknown-unknown --release --lib -p admin-ui; \
      # cargo build outputs admin_ui.wasm (package name with underscore) to workspace target dir \
      mkdir -p /app/crates/admin-ui/target/wasm32-unknown-unknown/release/; \
      cp /app/target/wasm32-unknown-unknown/release/admin_ui.wasm \
         /app/crates/admin-ui/target/wasm32-unknown-unknown/release/admin-ui.wasm; \
    fi

# Runtime stage - Nginx to serve static files
FROM nginx:alpine AS runtime

# Copy nginx config
COPY crates/admin-ui/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built WASM and static assets
COPY --from=builder /app/crates/admin-ui/target/wasm32-unknown-unknown/release/admin-ui.wasm /usr/share/nginx/html/
COPY --from=builder /app/crates/admin-ui/index.html /usr/share/nginx/html/
COPY --from=builder /app/crates/admin-ui/public /usr/share/nginx/html/

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/ || exit 1

# Run nginx
CMD ["nginx", "-g", "daemon off;"]
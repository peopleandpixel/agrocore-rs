# Multi-stage Dockerfile for agrocore Admin UI (WASM/Leptos + Trunk)
# Build stage - uses Trunk for proper WASM build
FROM rust:1.98-bookworm AS builder

# Install system dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install wasm target
RUN rustup target add wasm32-unknown-unknown

# Install Trunk (pinned version for reproducible builds)
RUN cargo install trunk --version 0.21.0 --locked

# Set working directory
WORKDIR /app

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY crates/ ./crates/

# Copy REAL logging crate (needed for macro exports in dependent crates)
RUN rm -rf crates/logging
COPY crates/logging ./crates/logging

# Copy SQLx query cache (needed for offline builds)
COPY .sqlx ./.sqlx

# Build the Admin UI with Trunk (this produces proper WASM + JS + HTML + CSS)
WORKDIR /app/crates/admin-ui
# Remove any cached dist folder
RUN rm -rf dist
# Create Trunk.toml with correct config format to disable wasm-opt
RUN echo '[tools]' > Trunk.toml && echo 'wasm_opt = "0"' >> Trunk.toml
RUN cat Trunk.toml
RUN trunk build --release

# Runtime stage - Nginx to serve static files
FROM nginx:alpine AS runtime

# Copy nginx config
COPY crates/admin-ui/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built WASM and static assets from Trunk dist folder
COPY --from=builder /app/crates/admin-ui/dist /usr/share/nginx/html

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/ || exit 1

# Run nginx
CMD ["nginx", "-g", "daemon off;"]
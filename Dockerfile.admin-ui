# Multi-stage Dockerfile for Admin UI (Leptos)
FROM rust:1.97-bookworm AS builder

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

# Install trunk
RUN cargo install trunk --locked

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

# Build dependencies first (caching layer)
RUN cd crates/admin-ui && trunk build --release 2>/dev/null || true

# Copy source and build
COPY . .
RUN cd crates/admin-ui && trunk build --release

# Runtime stage - Nginx for static files
FROM nginx:alpine AS runtime

# Copy built assets
COPY --from=builder /app/crates/admin-ui/dist /usr/share/nginx/html

# Nginx config for SPA
COPY <<EOF /etc/nginx/conf.d/default.conf
server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files \$uri \$uri/ /index.html;
    }

    # API proxy (optional, if using nginx as reverse proxy)
    location /api/ {
        proxy_pass http://api:8080;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }
}
EOF

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
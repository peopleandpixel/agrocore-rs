# Multi-stage Dockerfile for agrocore API
# Build stage
FROM rust:1.98-bookworm AS builder

# Install system dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy workspace Cargo files first for better caching
COPY Cargo.toml Cargo.lock ./
COPY crates/shared/Cargo.toml crates/shared/
COPY crates/domain/Cargo.toml crates/domain/
COPY crates/infrastructure/Cargo.toml crates/infrastructure/
COPY crates/lpis-providers/Cargo.toml crates/lpis-providers/
COPY crates/messaging/Cargo.toml crates/messaging/
COPY crates/api/Cargo.toml crates/api/
COPY crates/dashboard/Cargo.toml crates/dashboard/

# Create dummy source files to build dependencies
RUN mkdir -p crates/shared/src crates/domain/src crates/infrastructure/src crates/lpis-providers/src crates/messaging/src crates/api/src crates/dashboard/src
RUN echo "// dummy" > crates/shared/src/lib.rs
RUN echo "// dummy" > crates/domain/src/lib.rs
RUN echo "// dummy" > crates/infrastructure/src/lib.rs
RUN echo "// dummy" > crates/lpis-providers/src/lib.rs
RUN echo "// dummy" > crates/messaging/src/lib.rs
RUN echo "// dummy" > crates/api/src/lib.rs
RUN echo "// dummy" > crates/dashboard/src/lib.rs
RUN echo "fn main() {}" > crates/api/src/main.rs
RUN echo "fn main() {}" > crates/dashboard/src/main.rs

# Build dependencies (this layer will be cached)
# Only build the library crates, not the dashboard binary
RUN cargo build --release -p agrocore-shared -p agrocore-infrastructure -p agrocore-domain -p agrocore-lpis-providers -p agrocore-messaging

# Copy actual source code
COPY crates/shared/src crates/shared/src/
COPY crates/domain/src crates/domain/src/
COPY crates/infrastructure/src crates/infrastructure/src/
COPY crates/lpis-providers/src crates/lpis-providers/src/
COPY crates/messaging/src crates/messaging/src/
COPY crates/api/src crates/api/src/
COPY crates/dashboard/src crates/dashboard/src/

# Build the actual application
RUN cargo build --release --bin agrocore-api

# Runtime stage
FROM debian:bookworm-slim AS runtime

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    libssl3 \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -r -s /bin/false -u 1001 agrocore

# Set working directory
WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/target/release/agrocore-api /usr/local/bin/agrocore-api

# Copy config directory
COPY config/ /app/config/

# Set ownership
RUN chown -R agrocore:agrocore /app

# Switch to non-root user
USER agrocore

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -sf http://localhost:8080/api/v1/health || exit 1

# Run the application
CMD ["agrocore-api"]

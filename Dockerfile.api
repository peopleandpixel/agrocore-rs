# Multi-stage Dockerfile for agrocore API
# Build stage
FROM rust:1.97-bookworm AS builder

# Install system dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy workspace Cargo files first for better caching
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/

# Create dummy source files for library crates that API depends on
RUN mkdir -p crates/shared/src crates/domain/src crates/infrastructure/src crates/lpis-providers/src crates/messaging/src crates/api/src crates/dashboard/src crates/backup-service/src
RUN echo "// dummy" > crates/shared/src/lib.rs
RUN echo "// dummy" > crates/domain/src/lib.rs
RUN echo "// dummy" > crates/infrastructure/src/lib.rs
RUN echo "// dummy" > crates/lpis-providers/src/lib.rs
RUN echo "// dummy" > crates/messaging/src/lib.rs
RUN echo "// dummy" > crates/api/src/lib.rs
RUN echo "// dummy" > crates/dashboard/src/lib.rs
RUN echo "// dummy" > crates/backup-service/src/lib.rs

# Copy REAL logging crate (needed for macro exports in dependent crates)
RUN rm -rf crates/logging
COPY crates/logging ./crates/logging

# Copy migrations directory (needed for sqlx::migrate! in infrastructure)
COPY migrations ./migrations

# Copy SQLx query cache (needed for offline builds)
COPY .sqlx ./.sqlx

RUN echo "fn main() {}" > crates/api/src/main.rs
RUN echo "fn main() {}" > crates/dashboard/src/main.rs

# Build dependencies (this layer will be cached)
# Only build the LIBRARY crates that the API depends on
RUN cargo build --release -p agrocore-shared -p agrocore-infrastructure -p agrocore-domain -p agrocore-lpis-providers -p agrocore-messaging -p agrocore-logging -p agrocore-backup --lib

# Copy remaining actual source code (overwrites dummy files)
COPY crates/ crates/

# Build the actual application
RUN cargo build --release --bin agrocore-api

# Runtime stage
FROM debian:bookworm-slim AS runtime

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    libssl3 \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -r -s /bin/false -u 1001 agrocore

# Set working directory
WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/target/release/agrocore-api /usr/local/bin/agrocore-api

# Copy config directory
COPY config/ /app/config/

# Set ownership
RUN chown -R agrocore:agrocore /app

# Switch to non-root user
USER agrocore

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -sf http://localhost:8080/api/v1/health || exit 1

# Run the application
CMD ["agrocore-api"]
